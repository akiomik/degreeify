{
  "name": "degreeify",
  "description": "Show chord charts as degree names instead of chord names.",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "safari:xcode": "node scripts/safari/generate.ts",
    "safari:xcodebuild": "node scripts/safari/build.ts",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@wxt-dev/module-solid": "^1.1.4",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.4"
  }
}
